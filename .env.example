# Modèle des variables d'environnement.
# Copier ce fichier en .env et remplacer les valeurs « changez-moi ».
# Ne jamais committer le fichier .env.

# --- Base de données ---
POSTGRES_DB=procad
POSTGRES_USER=procad_user
POSTGRES_PASSWORD=changez-moi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changez-moi-valeur-longue-et-aleatoire
# 1 en développement, 0 en production
DJANGO_DEBUG=1
# Production : procad.com,www.procad.com (domaine réel)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Production : https://procad.com,https://www.procad.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost

# --- pgAdmin (développement uniquement) ---
PGADMIN_EMAIL=admin@procad.local
PGADMIN_PASSWORD=changez-moi
