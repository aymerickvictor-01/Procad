# Modèle des variables d'environnement (développement).
# Créé automatiquement en .env par scripts/installer.ps1 / installer.sh, avec des mots de passe
# aléatoires. À la main : copier en .env et remplacer les valeurs « changez-moi ».
# Ne jamais committer le fichier .env.

# --- Base de données ---
POSTGRES_DB=procad
POSTGRES_USER=procad_user
POSTGRES_PASSWORD=changez-moi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changez-moi-valeur-longue-et-aleatoire
# 1 en développement, 0 en production
DJANGO_DEBUG=1
# Production : procad.com,www.procad.com (domaine réel)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Production : https://procad.com,https://www.procad.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://localhost
# Fuseau horaire IANA. Cameroun (Yaoundé, Douala) : Africa/Douala (UTC+1)
DJANGO_TIME_ZONE=Africa/Douala
# Nombre de proxys devant Django : 0 en développement, 1 en production (Nginx)
DJANGO_NUM_PROXIES=0

# --- pgAdmin (développement uniquement) ---
# Identifiant de connexion à pgAdmin uniquement (aucun e-mail envoyé).
# Les domaines réservés (.local, .test...) sont refusés par pgAdmin.
PGADMIN_EMAIL=admin@procad.com
PGADMIN_PASSWORD=changez-moi

# --- Ports côté PC (développement) ---
# À changer seulement si un port est déjà utilisé sur la machine.
DB_PORT=5433
PGADMIN_PORT=5050
BACKEND_PORT=8000
FRONTEND_PORT=5174
