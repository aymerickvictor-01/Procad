# Modèle du fichier .env de PRODUCTION (sur le serveur : copier en .env, puis chmod 600 .env).
# Toutes les valeurs « changez-moi » doivent être remplacées par des valeurs fortes et uniques.

# --- Base de données ---
POSTGRES_DB=procad
POSTGRES_USER=procad_user
# Générer : python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=changez-moi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))" (différente du développement)
DJANGO_SECRET_KEY=changez-moi
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=procad.com,www.procad.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://procad.com,https://www.procad.com
DJANGO_TIME_ZONE=Africa/Douala
# Nginx est devant Django : 1 proxy
DJANGO_NUM_PROXIES=1

# --- E-mails (alertes des nouvelles demandes) ---
# Adresse(s) qui reçoivent une alerte à chaque message ou demande de devis (séparées par des virgules)
DJANGO_NOTIFY_EMAILS=camerinfos18@gmail.com
# Serveur d'envoi. Vide = e-mails affichés dans les journaux du backend (aucun envoi réel).
# Gmail : smtp.gmail.com, port 587, et un « mot de passe d'application » (voir le README).
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=camerinfos18@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=changez-moi
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=PROCAD <camerinfos18@gmail.com>
# Adresse du site, pour les liens dans les e-mails
DJANGO_SITE_URL=https://procad.com

# --- Nginx ---
# http-only : avant le certificat (phase 1) ; https : une fois le certificat obtenu (phase 2)
NGINX_CONFIG=http-only
# Noms servis, séparés par des espaces
NGINX_SERVER_NAMES=procad.com www.procad.com
# Nom du certificat Let's Encrypt (le premier domaine passé à certbot avec -d)
NGINX_CERT_NAME=procad.com

# Pas de variables pgAdmin en production.
