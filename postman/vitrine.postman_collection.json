{
  "info": {
    "name": "PROCAD - API vitrine",
    "description": "Collection de test de l'API PROCAD. Exécuter les dossiers dans l'ordre (Collection Runner).\n\n1. Sélectionner l'environnement « PROCAD - local » et y renseigner admin_username / admin_password.\n2. Le jeton CSRF est géré automatiquement (scripts de la collection).\n3. Les fichiers d'images sont dans postman/fixtures : régler le dossier de travail de Postman sur la racine du dépôt (Settings > General > Working directory).\n\nLes données créées par les tests sont supprimées à la fin de chaque dossier.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Ajoute le jeton CSRF aux requêtes qui modifient des données.",
          "if (![\"GET\", \"HEAD\", \"OPTIONS\"].includes(pm.request.method)) {",
          "    const token = pm.collectionVariables.get(\"csrf_token\");",
          "    if (token) pm.request.headers.upsert({ key: \"X-CSRFToken\", value: token });",
          "    // En HTTPS, Django contrôle aussi le Referer.",
          "    pm.request.headers.upsert({ key: \"Referer\", value: pm.variables.get(\"base_url\") + \"/\" });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Le jeton change à la connexion : on garde toujours la dernière valeur du cookie.",
          "const csrf = pm.cookies.get(\"csrftoken\");",
          "if (csrf) pm.collectionVariables.set(\"csrf_token\", csrf);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "csrf_token",
      "value": ""
    },
    {
      "key": "category_id",
      "value": ""
    },
    {
      "key": "service_id",
      "value": ""
    },
    {
      "key": "service_slug",
      "value": ""
    },
    {
      "key": "image_id",
      "value": ""
    },
    {
      "key": "testimonial_id",
      "value": ""
    },
    {
      "key": "message_id",
      "value": ""
    },
    {
      "key": "company_slogan",
      "value": ""
    }
  ],
